				},
				{
					"name": "项目详情",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/projects/{{projectId}}"
					}
				},
				{
					"name": "获取分享入口",
