						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/c/sessions/{{sessionId}}/summaries/current"
					}
				},
				{
					"name": "获取小结详情",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/c/board-summaries/{{summaryId}}"
					}
				},
				{
					"name": "添加小结条目",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"content\": \"事实内容\",\n  \"itemType\": \"FACT\"\n}"
						},
						"url": "{{baseUrl}}/api/c/board-summaries/{{summaryId}}/items"
					}
				},
				{
					"name": "更新小结条目",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"content\": \"更新内容\",\n  \"itemType\": \"FACT\",\n  \"isSelected\": true\n}"
						},
						"url": "{{baseUrl}}/api/c/summary-items/{{itemId}}"
					}
				},
				{
					"name": "删除小结条目",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/c/summary-items/{{itemId}}"
					}
				},
				{
					"name": "确认小结",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/c/board-summaries/{{summaryId}}/confirm"
					}
				}
			]
		},
		{
			"name": "C端-故事与人物",
			"item": [
				{
					"name": "创建故事",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/c/sessions/{{sessionId}}/stories"
					}
				},
				{
					"name": "获取故事",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/c/sessions/{{sessionId}}/stories?projectBoardId=1"
					}
				},
				{
					"name": "获取关键人物列表",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/c/sessions/{{sessionId}}/persons"
					}
				},
				{
					"name": "添加关键人物",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"新郎父亲\",\n  \"roleLabel\": \"家人\"\n}"
						},
						"url": "{{baseUrl}}/api/c/sessions/{{sessionId}}/persons"
					}
				},
				{
					"name": "更新关键人物",
