{
	"info": {
		"_postman_id": "digital-dad-api-2024",
		"name": "数字爸爸 API",
		"description": "数字爸爸 - 婚礼采访与生成平台 API 测试用例\n\n使用说明：\n1. 先调用「认证-发送验证码」获取验证码\n2. 调用「认证-主持人登录」或「认证-超管登录」获取 token（均为 POST /api/auth/login，超管登录时 body 增加 \"admin\": true）\n3. 主持人 token 存入变量 token，超管 token 存入 adminToken（登录接口 Tests 已自动处理）\n4. 当前用户、项目、板块、用户资料等统一路径，主持人/超管用各自 token 即可\n5. 需认证接口使用 Authorization: Bearer {{token}} 或 {{adminToken}}",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{"key": "baseUrl", "value": "http://101.34.64.224:8080"},
		{"key": "token", "value": ""},
		{"key": "adminToken", "value": ""},
		{"key": "projectId", "value": "1"},
		{"key": "sessionId", "value": "1"},
		{"key": "participantId", "value": "1"},
		{"key": "messageId", "value": "1"},
		{"key": "summaryId", "value": "1"},
		{"key": "itemId", "value": "1"},
		{"key": "personId", "value": "1"},
		{"key": "deliverableId", "value": "1"},
		{"key": "templateId", "value": "1"},
		{"key": "versionId", "value": "1"},
		{"key": "sceneId", "value": "1"},
		{"key": "hostId", "value": "1"},
		{"key": "shareToken", "value": "your-share-token"},
		{"key": "phone", "value": "13800138000"}
	],
	"item": [
		{
			"name": "公共",
			"item": [
				{
					"name": "根路径-服务状态",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/"
					}
				},
				{
					"name": "健康检查",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/api/health"
					}
				}
			]
		},
		{
			"name": "认证",
			"item": [
				{
					"name": "发送验证码",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"{{phone}}\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/send-code"
					}
				},
				{
					"name": "主持人登录(admin不传或false)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": ["var json = pm.response.json(); if (json.data && json.data.token) { pm.collectionVariables.set('token', json.data.token); }"],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"{{phone}}\",\n  \"code\": \"123456\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/login"
					}
				},
				{
					"name": "当前用户(主持人/超管共用)",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/auth/me"
					}
				},
				{
					"name": "退出登录",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/auth/logout"
					}
				},
				{
					"name": "超管登录(admin:true)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": ["var json = pm.response.json(); if (json.data && json.data.token) { pm.collectionVariables.set('adminToken', json.data.token); }"],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"{{phone}}\",\n  \"code\": \"123456\",\n  \"admin\": true\n}"
						},
						"url": "{{baseUrl}}/api/auth/login"
					}
				},
				{
					"name": "当前用户(超管token)",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
						"url": "{{baseUrl}}/api/auth/me"
					}
				}
			]
		},
		{
			"name": "C端-入口(免认证)",
			"item": [
				{
					"name": "扫码入口-获取项目信息",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/api/c/entry/{{shareToken}}"
					}
				}
			]
		},
		{
			"name": "C端-绑定与会话",
			"item": [
				{
					"name": "绑定参与者",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"role\": \"GROOM\"\n}"
						},
						"url": "{{baseUrl}}/api/c/projects/{{projectId}}/bind"
					}
				},
				{
					"name": "创建/恢复会话",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"participantId\": {{participantId}}\n}"
						},
						"url": "{{baseUrl}}/api/c/sessions"
					}
				},
				{
					"name": "获取会话",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/c/sessions/{{sessionId}}"
					}
				},
				{
					"name": "获取消息列表",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/c/sessions/{{sessionId}}/messages"
					}
				},
				{
					"name": "发送消息",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"content\": \"测试消息内容\",\n  \"audioUrl\": null,\n  \"transcriptText\": null\n}"
						},
						"url": "{{baseUrl}}/api/c/sessions/{{sessionId}}/messages"
					}
				},
				{
					"name": "更新消息",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"content\": \"更新后的内容\"\n}"
						},
						"url": "{{baseUrl}}/api/c/sessions/{{sessionId}}/messages/{{messageId}}"
					}
				},
				{
					"name": "删除消息",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/c/sessions/{{sessionId}}/messages/{{messageId}}"
					}
				},
				{
					"name": "提交会话",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/c/sessions/{{sessionId}}/submit"
					}
				}
			]
		},
		{
			"name": "C端-小结",
			"item": [
				{
					"name": "创建小结",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/c/sessions/{{sessionId}}/summaries"
					}
				},
				{
					"name": "获取当前小结",
