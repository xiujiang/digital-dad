						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/c/key-persons/{{personId}}"
					}
				}
			]
		},
		{
			"name": "项目(主持人/超管)",
			"item": [
				{
					"name": "创建项目",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"groomName\": \"张先生\",\n  \"brideName\": \"李女士\",\n  \"weddingDate\": \"2025-06-01\"\n}"
						},
						"url": "{{baseUrl}}/api/projects"
					}
				},
				{
					"name": "项目列表",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/projects?page=1&size=10"
